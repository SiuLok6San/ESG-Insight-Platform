# Copy to .env and adjust if needed. All values are optional.
# Scores never depend on the LLM; these settings only affect the optional
# AI suggestions and narrative report.

# Set to false to skip the local LLM entirely
LLM_ENABLED=true
# Ollama model and server address
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434
# Read timeout (seconds) for each Ollama request
LLM_TIMEOUT=120
# Maximum tokens generated per request
LLM_NUM_PREDICT=1024
# Attempts before giving up on the local LLM
LLM_MAX_RETRIES=3
