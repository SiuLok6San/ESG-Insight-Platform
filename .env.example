# Copy to .env and adjust if needed. All values are optional.
# Scores never depend on the LLM; these settings only affect the optional
# AI assistant and the offline AI evidence review.

# Ollama Cloud API key, used by the AI assistant and the evidence review.
# Paste your own key after the "=" in .env, never in .env.example.
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Set to false to turn the AI assistant off
LLM_ENABLED=true
# auto = Ollama Cloud when OLLAMA_API_KEY is set, otherwise a local Ollama server.
# Can also name a provider: ollama, ollama-cloud or gemini.
LLM_PROVIDER=auto
# Ollama Cloud model (empty = gemma4:31b)
OLLAMA_CLOUD_MODEL=
# Local Ollama model and server address
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434
# Read timeout (seconds) for each request
LLM_TIMEOUT=120
# Maximum tokens generated per request
LLM_NUM_PREDICT=1024
# Attempts before giving up on a request
LLM_MAX_RETRIES=3
# The chat fails fast when the AI service is busy: read timeout (seconds) and attempts per chat call
LLM_CHAT_TIMEOUT=45
LLM_CHAT_RETRIES=2
# AI questions each visitor may ask per session
AI_QUESTIONS_PER_SESSION=5
# AI requests (questions and reports) per UTC day for all visitors together
AI_QUESTIONS_PER_DAY=50

# Only needed for the evidence review with --provider gemini
GEMINI_API_KEY=
